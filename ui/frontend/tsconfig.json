{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "module": "esnext",
    "target": "es2021",
    "lib": ["es2021", "dom", "ES2023.Array"],
    "sourceMap": true,
    "jsx": "react",
    "moduleResolution": "bundler",
    "downlevelIteration": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "baseUrl": "./src",
    "paths": {
      "~/*": ["./*"],
      "@odh-dashboard/plugin-core/extension-points": ["./types/odh-plugin-core.d.ts"]
    },
    "importHelpers": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["./**/*.ts", "./**/*.tsx", "./**/*.js"],
  "exclude": ["node_modules", "dist"]
}

