# Project Matrix: Gatekeeper production candidate lane.
# This profile intentionally fails closed when the cluster contains preview-only
# Gateway dependencies or materially degraded cluster operators. A known
# GatewayAPIInstallConflict is non-blocking only when the required Mesh 3 and
# Gatekeeper Gateway resources are healthy; Gatekeeper records that exception. The
# production edge must also use HTTPS and a supported Gateway dependency.
GATEKEEPER_LANE=production
GATEKEEPER_PROFILE=gateway-production
GATEKEEPER_ALLOW_TECH_PREVIEW=0
GATEKEEPER_APPLY_NETWORK_POLICY=1
GATEKEEPER_INSTALL_FIXTURES=0
GATEKEEPER_ENABLE_NATIVE_AUTH=1
GATEKEEPER_AUTH_MODE=tokenreview
GATEKEEPER_ENABLE_INTERNAL_AUTHZ=1
GATEKEEPER_REQUIRE_INTERNAL_AUTHZ=1
GATEKEEPER_GATEWAY_EXPOSURE_MODE=openshift-route
GATEKEEPER_EXPECTED_GATEWAY_SERVICE_TYPE=LoadBalancer
GATEKEEPER_PREVIEW_SOURCE=red-hat-olm
GATEKEEPER_MANAGE_GATEWAY_DNS=1
GATEKEEPER_MANAGE_GATEWAY_TLS=1
GATEKEEPER_RUN_ARAMOCK_CONFORMANCE=0
